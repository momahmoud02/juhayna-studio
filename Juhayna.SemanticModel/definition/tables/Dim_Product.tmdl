	partition Dim_Product = m
		mode: import
		source =
				let
				    Sheet = SourceWorkbook{[Item="Products",Kind="Sheet"]}[Data],
				    Headers = Table.PromoteHeaders(Sheet,[PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Headers,{"Product_ID","Product_Name","Segment"}),
				    Typed = Table.TransformColumnTypes(Selected,{{"Product_ID",type text},{"Product_Name",type text},{"Segment",type text}},"en-US")
				in
				    Typed

