	measure 'Sales YTD' = VAR endDate=MIN(MAX(Dim_Date[Date]),[Last Data Date]) RETURN IF(HASONEVALUE(Dim_Date[Year]),CALCULATE([Net Sales],REMOVEFILTERS(Dim_Date),DATESBETWEEN(Dim_Date[Date],DATE(YEAR(endDate),1,1),endDate)))
		formatString: #,0.00
		displayFolder: 04 Time Intelligence
		lineageTag: cd7adcd8-a2a3-44a4-9e25-0979eb07067f

	measure 'Gross Profit YTD' = VAR endDate=MIN(MAX(Dim_Date[Date]),[Last Data Date]) RETURN IF(HASONEVALUE(Dim_Date[Year]),CALCULATE([Estimated Gross Profit],REMOVEFILTERS(Dim_Date),DATESBETWEEN(Dim_Date[Date],DATE(YEAR(endDate),1,1),endDate)))
		formatString: #,0.00
		displayFolder: 04 Time Intelligence
		lineageTag: 934e8bef-6755-48a2-9413-be5f5e18ab8c

	measure 'Sales Previous Month' = IF(HASONEVALUE(Dim_Date[Year_Month]),VAR d=MIN(Dim_Date[Date]) VAR startDate=EOMONTH(d,-2)+1 VAR endDate=EOMONTH(d,-1) RETURN CALCULATE([Net Sales],REMOVEFILTERS(Dim_Date),DATESBETWEEN(Dim_Date[Date],startDate,endDate)))
		formatString: #,0.00
		displayFolder: 04 Time Intelligence
		lineageTag: 44d468c3-f556-4d7f-99e2-5bd0efa750c7

	measure 'Sales MoM' = IF(HASONEVALUE(Dim_Date[Year_Month]),DIVIDE([Net Sales]-[Sales Previous Month],[Sales Previous Month]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Time Intelligence
		lineageTag: 6ed7b958-53b2-4642-923d-98baaddbe111

	measure 'Rolling 3M Sales' = VAR endDate=MIN(MAX(Dim_Date[Date]),[Last Data Date]) RETURN CALCULATE([Net Sales],REMOVEFILTERS(Dim_Date),DATESBETWEEN(Dim_Date[Date],EOMONTH(endDate,-3)+1,endDate))
		formatString: #,0.00
		displayFolder: 04 Time Intelligence
		lineageTag: 846d5a04-91cc-4fca-b8de-e3570e15acff

