	measure 'Last Data Date' = CALCULATE(MAX(Fact_Sales[Order_Date]),REMOVEFILTERS())
		formatString: dd MMM yyyy
		displayFolder: 04 Time Intelligence
		lineageTag: 06977850-90ad-4155-bdd5-d1f9a1b93edd

	measure 'Sales Comparable' = VAR d=FILTER(VALUES(Dim_Date[Date]),Dim_Date[Date]<=[Last Data Date] && Dim_Date[Date]>=DATE(2024,1,1)) RETURN IF(COUNTROWS(d)=0,BLANK(),CALCULATE([Net Sales],KEEPFILTERS(d)))
		formatString: #,0.00
		displayFolder: 04 Time Intelligence
		lineageTag: 7b3275d5-6cd8-4735-8d84-006d8ea5d2a3

	measure 'Sales LY' = VAR d=FILTER(VALUES(Dim_Date[Date]),Dim_Date[Date]<=[Last Data Date] && Dim_Date[Date]>=DATE(2024,1,1)) VAR p=SELECTCOLUMNS(d,"PriorDate",EDATE(Dim_Date[Date],-12)) RETURN IF(COUNTROWS(d)=0,BLANK(),CALCULATE([Net Sales],REMOVEFILTERS(Dim_Date),TREATAS(p,Dim_Date[Date])))
		formatString: #,0.00
		displayFolder: 04 Time Intelligence
		lineageTag: 505b053a-3f8d-4889-a420-d60f536f11ca

	measure 'Gross Profit Comparable' = VAR d=FILTER(VALUES(Dim_Date[Date]),Dim_Date[Date]<=[Last Data Date] && Dim_Date[Date]>=DATE(2024,1,1)) RETURN IF(COUNTROWS(d)=0,BLANK(),CALCULATE([Estimated Gross Profit],KEEPFILTERS(d)))
