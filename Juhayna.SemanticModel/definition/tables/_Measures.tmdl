		lineageTag: 9bb91c80-07b8-4965-ac90-cadaf38b86cc

	measure 'Sales YoY Caption' = IF(ISBLANK([Sales YoY]),"No prior-year comparison",FORMAT([Sales YoY],"+0.0%;-0.0%;0.0%") & " vs same dates LY")
