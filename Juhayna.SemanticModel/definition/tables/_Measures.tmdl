	measure 'Reported Sales LY' = VAR p=SELECTEDVALUE(Dim_Period[Period]) VAR label=IF(LEFT(p,2)="FY","FY","9M") VAR y=SELECTEDVALUE(Dim_Period[Year]) RETURN IF(NOT ISBLANK(p),CALCULATE(SUM(Fact_Financials[Net_Sales_EGP]),REMOVEFILTERS(Dim_Period),Dim_Period[Period]=label & FORMAT(y-1,"0")))
		formatString: #,0.00
		displayFolder: 07 Workbook Reported Financials
		lineageTag: be79b0f1-c5b8-4506-859b-5e0a79ece7d8

	measure 'Reported Sales YoY' = DIVIDE([Reported Net Sales]-[Reported Sales LY],[Reported Sales LY])
