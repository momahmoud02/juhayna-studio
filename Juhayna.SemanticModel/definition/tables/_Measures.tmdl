		displayFolder: 07 Workbook Reported Financials
		lineageTag: 9f9825ee-351a-4711-92d4-9aed92ea136b

	measure 'Simulated Sales in Reported Period' = VAR startDate=SELECTEDVALUE(Dim_Period[Start_Date]) VAR endDate=SELECTEDVALUE(Dim_Period[End_Date]) RETURN IF(NOT ISBLANK(startDate),CALCULATE([Net Sales],REMOVEFILTERS(Dim_Date),REMOVEFILTERS(Dim_Product),REMOVEFILTERS(Dim_Customer),REMOVEFILTERS(Dim_Channel),DATESBETWEEN(Dim_Date[Date],startDate,endDate)))
		formatString: #,0.00
		displayFolder: 07 Workbook Reported Financials
		lineageTag: 357447d6-da5e-4fc9-8594-10e135c810e9

	measure 'Reconciliation Difference' = IF(NOT ISBLANK([Reported Net Sales]),[Simulated Sales in Reported Period]-[Reported Net Sales])
		formatString: #,0.00
		displayFolder: 07 Workbook Reported Financials
		lineageTag: 90bd671c-faaa-44ef-80ab-1a7ad6d724c9

	measure 'Reconciliation Status' = VAR v=[Reconciliation Difference] RETURN IF(ISBLANK(v),"Select one reported period",IF(ABS(v)<=1,"Matched to the workbook period anchor","Monthly simulation is not calibrated to this interim period"))
		displayFolder: 07 Workbook Reported Financials
		lineageTag: cfc7b0cc-3129-4198-91fa-414503bbbff8

	measure 'Period Caption' = VAR rangeStart=MIN(Dim_Date[Date]) VAR rangeEnd=MIN(MAX(Dim_Date[Date]),[Last Data Date]) RETURN IF(rangeStart>rangeEnd,"No transactions in selected dates",FORMAT(rangeStart,"dd MMM yyyy") & " — " & FORMAT(rangeEnd,"dd MMM yyyy"))
