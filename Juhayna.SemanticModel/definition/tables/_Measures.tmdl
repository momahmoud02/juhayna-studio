	measure 'Transactions LY' = VAR d=FILTER(VALUES(Dim_Date[Date]),Dim_Date[Date]<=[Last Data Date] && Dim_Date[Date]>=DATE(2024,1,1)) VAR p=SELECTCOLUMNS(d,"PriorDate",EDATE(Dim_Date[Date],-12)) RETURN IF(COUNTROWS(d)=0,BLANK(),CALCULATE([Transactions],REMOVEFILTERS(Dim_Date),TREATAS(p,Dim_Date[Date])))
