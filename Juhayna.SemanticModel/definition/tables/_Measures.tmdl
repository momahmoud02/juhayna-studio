		displayFolder: 04 Time Intelligence
		lineageTag: 23b8bb69-3adf-484d-9f09-ad8019c50dcb

	measure 'Transactions Comparable' = VAR d=FILTER(VALUES(Dim_Date[Date]),Dim_Date[Date]<=[Last Data Date] && Dim_Date[Date]>=DATE(2024,1,1)) RETURN IF(COUNTROWS(d)=0,BLANK(),CALCULATE([Transactions],KEEPFILTERS(d)))
