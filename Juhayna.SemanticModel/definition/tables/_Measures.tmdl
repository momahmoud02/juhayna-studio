		displayFolder: 04 Time Intelligence
		lineageTag: 1dcef0df-bc21-494d-aa18-b926241cc371

	measure 'Gross Profit LY' = VAR d=FILTER(VALUES(Dim_Date[Date]),Dim_Date[Date]<=[Last Data Date] && Dim_Date[Date]>=DATE(2024,1,1)) VAR p=SELECTCOLUMNS(d,"PriorDate",EDATE(Dim_Date[Date],-12)) RETURN IF(COUNTROWS(d)=0,BLANK(),CALCULATE([Estimated Gross Profit],REMOVEFILTERS(Dim_Date),TREATAS(p,Dim_Date[Date])))
