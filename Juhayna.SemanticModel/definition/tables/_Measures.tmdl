	measure 'Top 5 Customer Share' = VAR topCustomers=TOPN(5,ALLSELECTED(Dim_Customer[Customer_Name]),[Net Sales],DESC,Dim_Customer[Customer_Name],ASC) RETURN DIVIDE(SUMX(topCustomers,[Net Sales]),CALCULATE([Net Sales],ALLSELECTED(Dim_Customer[Customer_Name])))
		formatString: 0.0%
